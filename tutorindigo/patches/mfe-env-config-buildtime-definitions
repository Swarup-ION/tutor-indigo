

let themeCookie = 'indigo-toggle-dark';
let themeCookieExpiry = 90; // days

(function() {
    console.log("[IndigoDebug] GLOBAL THEME CHECK START");
    const themeCookie = 'indigo-toggle-dark';
    const darkClass = 'indigo-dark-theme';
    const domain = '.learning-hub.iongroup.com';

    // 1. Helper to get cookie value by name
    const getCookie = (name) => {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
    };

    // 2. Read existing theme
    const currentTheme = getCookie(themeCookie);
    console.log("[IndigoDebug] Current Cookie Value:", currentTheme);

    // 3. Logic: If it's 'dark' OR if there is NO cookie yet (default to dark)
    if (currentTheme === 'dark' || !currentTheme) {
        console.log("[IndigoDebug] Applying Dark Theme");
        document.body.classList.add(darkClass);
        document.documentElement.classList.add(darkClass);

        // If no cookie existed, set it to 'dark' so other pages stay in sync
        if (!currentTheme) {
            const expiry = new Date();
            expiry.setFullYear(expiry.getFullYear() + 1);
            document.cookie = `${themeCookie}=dark; expires=${expiry.toUTCString()}; path=/; domain=${domain}; SameSite=Lax; Secure`;
        }
    } else {
        console.log("[IndigoDebug] Cookie is 'light', removing dark classes");
        document.body.classList.remove(darkClass);
        document.documentElement.classList.remove(darkClass);
    }

    console.log("[IndigoDebug] GLOBAL THEME CHECK COMPLETE");
})();

const AddDarkTheme = () => {
  console.log("[IndigoDebug] MFE can see");
  document.body.classList.add('indigo-dark-theme');
  const cookies = new Cookies();
  const isThemeToggleEnabled = getConfig().INDIGO_ENABLE_DARK_TOGGLE;

  const getCookieExpiry = () => {
    console.log("[IndigoDebug] MFE can see");
    document.body.classList.add('indigo-dark-theme');
    const today = new Date();
    return new Date(today.getFullYear(), today.getMonth(), today.getDate() + themeCookieExpiry);
  };

  const getCookieOptions = () => {
    console.log("[IndigoDebug] MFE can see");
    document.body.classList.add('indigo-dark-theme');
    const serverURL = new URL(getConfig().LMS_BASE_URL);
    const options = { domain: serverURL.hostname, path: '/', expires: getCookieExpiry() };
    return options;
  };

  const addDarkThemeToIframes = () => {
    console.log("[IndigoDebug] MFE can see");
    document.body.classList.add('indigo-dark-theme');
    const iframes = document.getElementsByTagName('iframe');
    const iframesLength = iframes.length;
    if (iframesLength > 0) {
      Array.from({ length: iframesLength }).forEach((_, index) => {
        const style = document.createElement('style');
        style.textContent = `
          body{
            background-color: #0D0D0E;
            color: #ccc;
          }
          a {color: #ccc;}
          a:hover{color: #d3d3d3;}
          `;
        if (iframes[index].contentDocument) { iframes[index].contentDocument.head.appendChild(style); }
      });
    }
  };

  useEffect(() => {
      // 1. Log the initial state for debugging
      const currentTheme = cookies.get(themeCookie);
      const toggleConfig = getConfig().INDIGO_ENABLE_DARK_TOGGLE;
      
      console.log("[IndigoDebug] MFE Load Detected");
      console.log("[IndigoDebug] Cookie value:", currentTheme);
      console.log("[IndigoDebug] Toggle Enabled in Config:", toggleConfig);

      const observer = new MutationObserver(() => {
          addDarkThemeToIframes();
      });

      // 2. MODIFIED CONDITION:
      // We enter if the cookie is 'dark' OR if there is NO cookie (first run default)
      if (currentTheme === 'dark' || !currentTheme) {
          console.log("[IndigoDebug] Condition met! Applying Dark Theme...");
          
          document.body.classList.add('indigo-dark-theme');
          
          observer.observe(document.body, { childList: true, subtree: true });
          
          // Ensure the cookie is set to 'dark' for future refreshes
          const options = getCookieOptions();
          console.log("[IndigoDebug] Setting cookie with options:", options);
          cookies.set(themeCookie, 'dark', options);

          setTimeout(() => {
              console.log("[IndigoDebug] Disconnecting MutationObserver (15s timeout)");
              observer?.disconnect();
          }, 15000);
      } else {
          console.log("[IndigoDebug] Condition NOT met. Dark mode skipped.");
      }

      return () => {
          console.log("[IndigoDebug] Component Unmounting - cleaning up observer");
          observer?.disconnect();
      };
  }, []);

  return (<div />);
};
